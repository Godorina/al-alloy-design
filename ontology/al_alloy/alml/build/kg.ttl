ml:MechanicalProperty a skos:Concept ;
    skos:definition "Measured properties used as inputs (e.g. UTS to predict conductivity)."@en,
        "입력으로 쓴 측정 성질(예: 전도도 예측에 쓴 UTS)."@ko ;
    skos:inScheme ml:FeatureKindScheme ;
    skos:prefLabel "Mechanical properties"@en,
        "기계적 성질"@ko .

e:study-10.1016_j.jpcs.2026.114030-m0-GradientBoosting a ml:Model ;
    ml:algorithm ml:GradientBoosting .

al:YTS a skos:Concept ;
    skos:definition "0.2 % offset yield strength in a tensile test, in MPa."@en,
        "인장시험의 0.2 % 오프셋 항복강도(MPa)."@ko ;
    skos:inScheme al:PropertyKindScheme ;
    skos:prefLabel "Yield strength"@en,
        "항복강도"@ko .

ml:Accuracy a skos:Concept ;
    skos:definition "Higher is better; fraction or % of correct classes."@en,
        "높을수록 좋다. 맞힌 비율(분율 또는 %)."@ko ;
    skos:inScheme ml:MetricScheme ;
    skos:prefLabel "Accuracy"@en,
        "정확도"@ko .

ml:AdaBoost a skos:Concept ;
    skos:definition "Adaptive boosting of weak learners."@en,
        "약한 학습기를 가중치로 이어 붙이는 부스팅."@ko ;
    skos:inScheme ml:AlgorithmScheme ;
    skos:prefLabel "AdaBoost"@en,
        "AdaBoost"@ko .

ml:BalancedAccuracy a skos:Concept ;
    skos:definition "Mean recall over classes; higher is better."@en,
        "클래스별 재현율 평균. 높을수록 좋다."@ko ;
    skos:inScheme ml:MetricScheme ;
    skos:prefLabel "Balanced accuracy"@en,
        "균형 정확도"@ko .

ml:ConvolutionalNetwork a skos:Concept ;
    skos:definition "CNNs and U-Nets for images."@en,
        "이미지용 CNN, U-Net."@ko ;
    skos:inScheme ml:AlgorithmScheme ;
    skos:prefLabel "Convolutional network"@en,
        "합성곱 신경망"@ko .

ml:DataSourceScheme a skos:ConceptScheme ;
    rdfs:label "Data sources"@en,
        "데이터 출처"@ko .

ml:Image a skos:Concept ;
    skos:definition "Micrographs, surface images or tomography."@en,
        "조직 사진, 표면 이미지, 단층 촬영."@ko ;
    skos:inScheme ml:FeatureKindScheme ;
    skos:prefLabel "Image"@en,
        "이미지"@ko .

ml:KNearestNeighbours a skos:Concept ;
    skos:definition "Prediction from the nearest training points."@en,
        "가장 가까운 학습 데이터로 예측한다."@ko ;
    skos:inScheme ml:AlgorithmScheme ;
    skos:prefLabel "k-nearest neighbours"@en,
        "k-최근접 이웃"@ko .

ml:Optimization a skos:Concept ;
    skos:definition "Tune process parameters for a target, e.g. by Bayesian optimization."@en,
        "베이지안 최적화 등으로 목표에 맞게 공정 변수를 조정한다."@ko ;
    skos:inScheme ml:TaskTypeScheme ;
    skos:prefLabel "Process optimization"@en,
        "공정 최적화"@ko .

ml:Recall a skos:Concept ;
    skos:definition "Higher is better."@en,
        "높을수록 좋다."@ko ;
    skos:inScheme ml:MetricScheme ;
    skos:prefLabel "Recall (sensitivity)"@en,
        "재현율(민감도)"@ko .

e:study-10.1038_s41529-024-00489-z-m0-RandomForest a ml:Model ;
    ml:algorithm ml:RandomForest .

ml:MSE a skos:Concept ;
    skos:definition "Lower is better; in the squared unit of the target."@en,
        "낮을수록 좋다. 목표 단위의 제곱."@ko ;
    skos:inScheme ml:MetricScheme ;
    skos:prefLabel "Mean squared error"@en,
        "평균 제곱 오차"@ko .

al:InhibitionEfficiency a skos:Concept ;
    skos:definition "Efficiency of a corrosion inhibitor, in %."@en,
        "부식 억제제의 효율(%)."@ko ;
    skos:inScheme al:PropertyKindScheme ;
    skos:prefLabel "Corrosion inhibition efficiency"@en,
        "부식 억제 효율"@ko .

al:RouteScheme a skos:ConceptScheme ;
    rdfs:label "Product routes"@en,
        "가공 방식"@ko .

al:Series5xxx a skos:Concept ;
    skos:definition "Alloy family by main alloying elements: Al-Mg (5xxx)."@en,
        "주 합금 원소로 나눈 합금 계열: Al-Mg계(5xxx)."@ko ;
    skos:inScheme al:SeriesScheme ;
    skos:notation "5xxx" ;
    skos:prefLabel "Al-Mg (5xxx)"@en,
        "Al-Mg계(5xxx)"@ko .

ml:TaskTypeScheme a skos:ConceptScheme ;
    rdfs:label "Task types"@en,
        "과제 종류"@ko .

al:StepTypeScheme a skos:ConceptScheme ;
    rdfs:label "Process step types"@en,
        "공정 단계 종류"@ko .

ml:DecisionTree a skos:Concept ;
    skos:definition "A single decision or regression tree."@en,
        "단일 결정·회귀 트리."@ko ;
    skos:inScheme ml:AlgorithmScheme ;
    skos:prefLabel "Decision tree"@en,
        "결정 트리"@ko .

al:SeriesScheme a skos:ConceptScheme ;
    rdfs:label "Alloy series"@en,
        "합금 계열"@ko .

al:TemperScheme a skos:ConceptScheme ;
    rdfs:label "Temper designations"@en,
        "템퍼 기호"@ko .

ml:Simulation a skos:Concept ;
    skos:definition "Computed by DFT, CALPHAD, FEM or other simulation."@en,
        "DFT, CALPHAD, FEM 등으로 계산했다."@ko ;
    skos:inScheme ml:DataSourceScheme ;
    skos:prefLabel "Simulation"@en,
        "시뮬레이션"@ko .

ml:FeatureKindScheme a skos:ConceptScheme ;
    rdfs:label "Input feature kinds"@en,
        "입력 특징 종류"@ko .

al:SeriesCastAlSi a skos:Concept ;
    skos:definition "Alloy family by main alloying elements: Cast Al-Si, including printed AlSi10Mg."@en,
        "주 합금 원소로 나눈 합금 계열: Al-Si 주조 합금(적층 AlSi10Mg 포함)."@ko ;
    skos:inScheme al:SeriesScheme ;
    skos:notation "cast_AlSi" ;
    skos:prefLabel "Cast Al-Si"@en,
        "Al-Si 주조 합금"@ko .

ml:External a skos:Concept ;
    skos:definition "New experiments or another dataset not used in model building."@en,
        "모델을 만들 때 쓰지 않은 새 실험이나 다른 데이터."@ko ;
    skos:inScheme ml:EvaluationScheme ;
    skos:prefLabel "External validation"@en,
        "외부 검증"@ko .

ml:MAPE a skos:Concept ;
    skos:definition "Lower is better; in %."@en,
        "낮을수록 좋다. 단위 %."@ko ;
    skos:inScheme ml:MetricScheme ;
    skos:prefLabel "Mean absolute percentage error"@en,
        "평균 절대 백분율 오차"@ko .

al:EL a skos:Concept ;
    skos:definition "Elongation after fracture in a tensile test, in %."@en,
        "인장시험의 파단 연신율(%)."@ko ;
    skos:inScheme al:PropertyKindScheme ;
    skos:prefLabel "Elongation"@en,
        "연신율"@ko .

ml:LinearRegression a skos:Concept ;
    skos:altLabel "Elastic net",
        "Lasso",
        "Ridge" ;
    skos:definition "Linear, ridge or lasso regression."@en,
        "선형, 릿지, 라쏘 회귀."@ko ;
    skos:inScheme ml:AlgorithmScheme ;
    skos:prefLabel "Linear or regularized regression"@en,
        "선형·규제 회귀"@ko .

ml:Database a skos:Concept ;
    skos:definition "A commercial or public materials database (e.g. Total Materia, MatWeb, NIMS)."@en,
        "상용·공개 재료 DB(예: Total Materia, MatWeb, NIMS)."@ko ;
    skos:inScheme ml:DataSourceScheme ;
    skos:prefLabel "Materials database"@en,
        "재료 데이터베이스"@ko .

ml:GaussianProcess a skos:Concept ;
    skos:altLabel "Kriging" ;
    skos:definition "Gaussian process regression or classification."@en,
        "가우시안 프로세스 회귀·분류."@ko ;
    skos:inScheme ml:AlgorithmScheme ;
    skos:prefLabel "Gaussian process"@en,
        "가우시안 프로세스"@ko .

ml:MetricScheme a skos:ConceptScheme ;
    rdfs:label "Evaluation metrics"@en,
        "평가 지표"@ko .

al:Series2xxx a skos:Concept ;
    skos:definition "Alloy family by main alloying elements: Al-Cu (2xxx)."@en,
        "주 합금 원소로 나눈 합금 계열: Al-Cu계(2xxx)."@ko ;
    skos:inScheme al:SeriesScheme ;
    skos:notation "2xxx" ;
    skos:prefLabel "Al-Cu (2xxx)"@en,
        "Al-Cu계(2xxx)"@ko .

al:Series7xxx a skos:Concept ;
    skos:definition "Alloy family by main alloying elements: Al-Zn-Mg (7xxx)."@en,
        "주 합금 원소로 나눈 합금 계열: Al-Zn-Mg계(7xxx)."@ko ;
    skos:inScheme al:SeriesScheme ;
    skos:notation "7xxx" ;
    skos:prefLabel "Al-Zn-Mg (7xxx)"@en,
        "Al-Zn-Mg계(7xxx)"@ko .

al:Series6xxx a skos:Concept ;
    skos:definition "Alloy family by main alloying elements: Al-Mg-Si (6xxx)."@en,
        "주 합금 원소로 나눈 합금 계열: Al-Mg-Si계(6xxx)."@ko ;
    skos:inScheme al:SeriesScheme ;
    skos:notation "6xxx" ;
    skos:prefLabel "Al-Mg-Si (6xxx)"@en,
        "Al-Mg-Si계(6xxx)"@ko .

ml:AlgorithmScheme a skos:ConceptScheme ;
    rdfs:label "Machine-learning algorithms"@en,
        "머신러닝 알고리즘"@ko ;
    skos:closeMatch mls:Algorithm .

ml:Literature a skos:Concept ;
    skos:definition "Collected from published papers."@en,
        "출판 논문에서 모았다."@ko ;
    skos:inScheme ml:DataSourceScheme ;
    skos:prefLabel "Literature compilation"@en,
        "문헌 수집"@ko .

ml:TestCondition a skos:Concept ;
    skos:definition "Test parameters such as strain rate, orientation or load."@en,
        "변형률 속도, 방향, 하중 같은 시험 변수."@ko ;
    skos:inScheme ml:FeatureKindScheme ;
    skos:prefLabel "Test condition"@en,
        "시험 조건"@ko .

ml:ComputedDescriptor a skos:Concept ;
    skos:definition "Quantities from DFT, CALPHAD or physics models."@en,
        "DFT, CALPHAD, 물리 모델로 계산한 값."@ko ;
    skos:inScheme ml:FeatureKindScheme ;
    skos:prefLabel "Computed descriptor"@en,
        "계산 기술자"@ko .

ml:Environment a skos:Concept ;
    skos:definition "Service or test environment (medium, temperature, humidity, pollutants)."@en,
        "사용·시험 환경(매질, 온도, 습도, 오염물)."@ko ;
    skos:inScheme ml:FeatureKindScheme ;
    skos:prefLabel "Environment"@en,
        "환경"@ko .

ml:SupportVectorRegression a skos:Concept ;
    skos:definition "Support vector regression or classification."@en,
        "서포트 벡터 회귀·분류."@ko ;
    skos:inScheme ml:AlgorithmScheme ;
    skos:prefLabel "Support vector machine"@en,
        "서포트 벡터 머신"@ko .

al:UTS a skos:Concept ;
    skos:definition "Maximum engineering stress in a tensile test, in MPa."@en,
        "인장시험의 최대 공칭응력(MPa)."@ko ;
    skos:inScheme al:PropertyKindScheme ;
    skos:prefLabel "Ultimate tensile strength"@en,
        "인장강도"@ko .

ml:GradientBoosting a skos:Concept ;
    skos:altLabel "CatBoost",
        "LightGBM",
        "XGBoost" ;
    skos:definition "Boosted trees such as XGBoost, LightGBM or GBR."@en,
        "XGBoost, LightGBM, GBR 같은 부스팅 트리."@ko ;
    skos:inScheme ml:AlgorithmScheme ;
    skos:prefLabel "Gradient boosting"@en,
        "그래디언트 부스팅"@ko .

al:PropertyKindScheme a skos:ConceptScheme ;
    rdfs:label "Property kinds"@en,
        "물성 종류"@ko .

ml:MAE a skos:Concept ;
    skos:definition "Lower is better; in the unit of the target."@en,
        "낮을수록 좋다. 목표와 같은 단위."@ko ;
    skos:inScheme ml:MetricScheme ;
    skos:prefLabel "Mean absolute error"@en,
        "평균 절대 오차"@ko .

ml:RandomForest a skos:Concept ;
    skos:altLabel "Extra trees" ;
    skos:definition "Ensemble of decision trees by bagging."@en,
        "배깅한 결정 트리 앙상블."@ko ;
    skos:inScheme ml:AlgorithmScheme ;
    skos:prefLabel "Random forest"@en,
        "랜덤 포레스트"@ko .

ml:NeuralNetwork a skos:Concept ;
    skos:definition "Fully connected (MLP) or recurrent networks."@en,
        "완전 연결(MLP)·순환 신경망."@ko ;
    skos:inScheme ml:AlgorithmScheme ;
    skos:prefLabel "Neural network"@en,
        "신경망"@ko .

ml:RMSE a skos:Concept ;
    skos:definition "Lower is better; in the unit of the target."@en,
        "낮을수록 좋다. 목표와 같은 단위."@ko ;
    skos:inScheme ml:MetricScheme ;
    skos:prefLabel "Root mean squared error"@en,
        "평균 제곱근 오차"@ko .

ml:Processing a skos:Concept ;
    skos:definition "Heat treatment, temper, forming or printing parameters."@en,
        "열처리, 템퍼, 성형·적층 변수."@ko ;
    skos:inScheme ml:FeatureKindScheme ;
    skos:prefLabel "Processing"@en,
        "공정"@ko .

ml:Composition a skos:Concept ;
    skos:definition "Element contents of the alloy."@en,
        "합금의 원소 함량."@ko ;
    skos:inScheme ml:FeatureKindScheme ;
    skos:prefLabel "Composition"@en,
        "조성"@ko .

ml:Experiment a skos:Concept ;
    skos:definition "Measured by the authors for the study."@en,
        "저자가 연구를 위해 측정했다."@ko ;
    skos:inScheme ml:DataSourceScheme ;
    skos:prefLabel "Own experiments"@en,
        "자체 실험"@ko .

ml:Study a owl:Class ;
    rdfs:label "Study"@en,
        "연구"@ko ;
    rdfs:comment "One published paper; its title, DOI and year use schema:name, schema:identifier and schema:datePublished."@en,
        "출판된 논문 하나. 제목·DOI·연도는 schema:name, schema:identifier, schema:datePublished로 적는다."@ko ;
    rdfs:subClassOf schema:ScholarlyArticle .

ml:Regression a skos:Concept ;
    skos:definition "Predict a numeric property."@en,
        "수치 물성을 예측한다."@ko ;
    skos:inScheme ml:TaskTypeScheme ;
    skos:prefLabel "Regression"@en,
        "회귀"@ko .

ml:R2 a skos:Concept ;
    skos:definition "Higher is better."@en,
        "높을수록 좋다."@ko ;
    skos:inScheme ml:MetricScheme ;
    skos:prefLabel "Coefficient of determination (R2)"@en,
        "결정계수(R2)"@ko .

ml:CrossValidation a skos:Concept ;
    skos:definition "k-fold, leave-one-out or grouped (leave-one-composition-out) cross-validation."@en,
        "k-겹, 하나 빼기, 그룹(조성 하나 빼기) 교차 검증."@ko ;
    skos:inScheme ml:EvaluationScheme ;
    skos:prefLabel "Cross-validation"@en,
        "교차 검증"@ko .

ml:Dataset a owl:Class ;
    rdfs:label "Dataset"@en,
        "데이터셋"@ko ;
    rdfs:comment "The data a task was trained or tested on: size, kind of source, where it is published."@en,
        "과제의 학습·시험 데이터: 크기, 출처 종류, 공개 위치."@ko ;
    skos:closeMatch mls:Dataset .

ml:Task a owl:Class ;
    rdfs:label "Task"@en,
        "예측 과제"@ko ;
    rdfs:comment "What a study models: target properties, alloy series, task type, input feature kinds, data, models and scores."@en,
        "연구가 모델링한 과제: 목표 물성, 합금 계열, 과제 종류, 입력 특징 종류, 데이터, 모델, 성능."@ko ;
    skos:closeMatch mls:Task .

ml:Test a skos:Concept ;
    skos:definition "Data held out from training, from the same source."@en,
        "같은 출처에서 학습에 쓰지 않고 떼어 둔 데이터."@ko ;
    skos:inScheme ml:EvaluationScheme ;
    skos:prefLabel "Held-out test set"@en,
        "시험 세트"@ko .

ml:Finding a owl:Class ;
    rdfs:label "Finding"@en,
        "핵심 결론"@ko ;
    rdfs:comment "A main conclusion of a study, as a short statement backed by a quote."@en,
        "연구의 주요 결론 하나. 인용으로 뒷받침되는 짧은 문장."@ko .

ml:Score a owl:Class ;
    rdfs:label "Score"@en,
        "성능 점수"@ko ;
    rdfs:comment "One reported evaluation of a model: a metric and its value."@en,
        "모델 평가 결과 하나: 지표와 값."@ko ;
    skos:closeMatch mls:ModelEvaluation .

ml:Model a owl:Class ;
    rdfs:label "Model"@en,
        "모델"@ko ;
    rdfs:comment "A machine-learning model of a task, named by its algorithm."@en,
        "과제의 머신러닝 모델. 알고리즘으로 구분한다."@ko ;
    skos:closeMatch mls:Model .

ml:Evidence a owl:Class ;
    rdfs:label "Evidence"@en,
        "근거"@ko ;
    rdfs:comment "A verbatim quote and its page in the paper text."@en,
        "논문 텍스트의 그대로 옮긴 인용과 쪽."@ko .

