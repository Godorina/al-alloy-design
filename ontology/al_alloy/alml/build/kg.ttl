al:ContactAngle a skos:Concept ;
    skos:definition "Wetting contact angle, in degrees."@en,
        "젖음 접촉각(도)."@ko ;
    skos:inScheme al:PropertyKindScheme ;
    skos:prefLabel "Contact angle"@en,
        "접촉각"@ko .

al:CorrosionDepth a skos:Concept ;
    skos:definition "Intergranular, pitting or exfoliation attack depth."@en,
        "입계·공식·박리 부식 깊이."@ko ;
    skos:inScheme al:PropertyKindScheme ;
    skos:prefLabel "Corrosion depth"@en,
        "부식 깊이"@ko .

al:HeatingScheme a skos:ConceptScheme ;
    rdfs:label "Heating methods"@en,
        "가열 방식"@ko .

al:NaturalAgeing a skos:Concept ;
    skos:definition "Ageing at room temperature."@en,
        "상온에서 일어나는 시효."@ko ;
    skos:hiddenLabel "natural",
        "room temperature",
        "room-temperature" ;
    skos:inScheme al:StepTypeScheme ;
    skos:prefLabel "Natural ageing"@en,
        "자연시효"@ko .

ml:F1 a skos:Concept ;
    skos:definition "Higher is better."@en,
        "높을수록 좋다."@ko ;
    skos:inScheme ml:MetricScheme ;
    skos:prefLabel "F1 score"@en,
        "F1 점수"@ko .

ml:Interpretation a skos:Concept ;
    skos:definition "Extract relations or feature importance from a trained model, e.g. by MCMC sampling."@en,
        "학습한 모델에서 관계나 특징 중요도를 뽑는다. 예: MCMC 샘플링."@ko ;
    skos:inScheme ml:TaskTypeScheme ;
    skos:prefLabel "Interpretation"@en,
        "해석"@ko .

ml:MCMC a skos:Concept ;
    skos:definition "Sampling over a model or posterior, e.g. to extract relations."@en,
