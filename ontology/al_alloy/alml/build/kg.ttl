@prefix al: <https://w3id.org/al6xxx#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix e: <https://w3id.org/alml/entity/> .
@prefix ml: <https://w3id.org/alml#> .
@prefix mls: <http://www.w3.org/ns/mls#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

al:Cast a skos:Concept ;
    skos:definition "Cast product, e.g. sand or permanent-mould casting."@en,
        "사형·금형 주조 제품."@ko ;
    skos:inScheme al:RouteScheme ;
    skos:prefLabel "Cast"@en,
        "주조재"@ko .

al:ColdRolling a skos:Concept ;
    skos:definition "Rolling at room temperature."@en,
        "상온 압연."@ko ;
    skos:hiddenLabel "cold roll",
        "cold-roll" ;
    skos:inScheme al:StepTypeScheme ;
    skos:prefLabel "Cold rolling"@en,
        "냉간압연"@ko .

al:ColdWorking a skos:Concept ;
    skos:definition "Room-temperature forming other than rolling: extrusion, drawing, incremental forming (SPIF)."@en,
        "압연 외의 상온 성형: 압출, 인발, 점진 성형(SPIF)."@ko ;
    skos:hiddenLabel "cold extru",
        "cold work",
        "cold-work",
        "draw",
        "form",
        "incremental",
        "room temperature",
        "room-temperature",
        "spif" ;
    skos:inScheme al:StepTypeScheme ;
    skos:prefLabel "Cold working"@en,
        "냉간가공"@ko .

al:CorrosionRating a skos:Concept ;
    skos:definition "Categorical corrosion resistance, e.g. Excellent or Good."@en,
        "범주형 내식성. 예: Excellent, Good."@ko ;
    skos:inScheme al:PropertyKindScheme ;
    skos:prefLabel "Corrosion rating"@en,
        "부식 등급"@ko .

al:Drawn a skos:Concept ;
    skos:definition "Drawn product, e.g. deep-drawn parts or drawn tube."@en,
        "인발·딥드로잉 제품."@ko ;
    skos:inScheme al:RouteScheme ;
    skos:prefLabel "Drawn"@en,
        "인발재"@ko .

al:Extrusion a skos:Concept ;
    skos:definition "Extruded product."@en,
        "압출재."@ko ;
    skos:inScheme al:RouteScheme ;
    skos:prefLabel "Extrusion"@en,
        "압출"@ko .

al:F a skos:Concept ;
    skos:definition "As fabricated; no thermal treatment required."@en,
        "가공한 그대로. 열처리가 필요 없다."@ko ;
    skos:inScheme al:TemperScheme ;
    skos:notation "F" ;
    skos:prefLabel "F (as fabricated)"@en,
        "F (가공 그대로)"@ko .

al:Forged a skos:Concept ;
    skos:definition "Forged product."@en,
        "단조재."@ko ;
    skos:inScheme al:RouteScheme ;
    skos:prefLabel "Forged"@en,
        "단조재"@ko .

al:Furnace a skos:Concept ;
    skos:definition "Conventional furnace or resistance heating."@en,
        "일반 가열로 또는 저항 가열."@ko ;
    skos:inScheme al:HeatingScheme ;
    skos:prefLabel "Furnace"@en,
        "가열로"@ko .

al:H a skos:Concept ;
    skos:definition "Strain-hardened; no thermal treatment required."@en,
        "가공경화. 열처리가 필요 없다."@ko ;
    skos:inScheme al:TemperScheme ;
    skos:notation "H" ;
    skos:prefLabel "H (strain-hardened)"@en,
        "H (가공경화)"@ko .

al:Homogenization a skos:Concept ;
    skos:definition "High-temperature hold of the cast material to even out segregation."@en,
        "주조재의 편석을 없애기 위한 고온 유지."@ko ;
    skos:hiddenLabel "homogeni",
        "homogenis" ;
    skos:inScheme al:StepTypeScheme ;
    skos:prefLabel "Homogenization"@en,
        "균질화"@ko .

al:HotRolling a skos:Concept ;
    skos:definition "Rolling above the recrystallization temperature."@en,
        "재결정 온도 이상에서의 압연."@ko ;
    skos:hiddenLabel "hot roll",
        "hot-roll" ;
    skos:inScheme al:StepTypeScheme ;
    skos:prefLabel "Hot rolling"@en,
        "열간압연"@ko .

al:HotWorking a skos:Concept ;
    skos:definition "Forming above the recrystallization temperature other than rolling: hot extrusion, hot forging."@en,
        "압연 외의 고온 성형: 열간 압출, 열간 단조."@ko ;
    skos:hiddenLabel "extru",
        "forg",
        "hot extru",
        "hot forg",
        "hot work",
        "hot-extru" ;
    skos:inScheme al:StepTypeScheme ;
    skos:prefLabel "Hot working"@en,
        "열간가공"@ko .

al:Infrared a skos:Concept ;
    skos:altLabel "IR"@en ;
    skos:definition "Rapid infrared heating."@en,
        "급속 적외선 가열."@ko ;
    skos:inScheme al:HeatingScheme ;
    skos:prefLabel "Infrared"@en,
        "적외선"@ko .

al:O a skos:Concept ;
    skos:definition "Annealed to the softest condition."@en,
        "가장 무른 상태로 소둔."@ko ;
    skos:inScheme al:TemperScheme ;
    skos:notation "O" ;
    skos:prefLabel "O (annealed)"@en,
        "O (소둔)"@ko ;
    al:impliesStepType al:Annealing .

al:Plate a skos:Concept ;
    skos:definition "Rolled plate."@en,
        "압연 후판."@ko ;
    skos:inScheme al:RouteScheme ;
    skos:prefLabel "Plate"@en,
        "후판"@ko .

al:Printed a skos:Concept ;
    skos:definition "Additively manufactured part, e.g. laser powder bed fusion or wire-arc."@en,
        "레이저 분말 베드 용융, 와이어 아크 등으로 적층 제조한 부품."@ko ;
    skos:inScheme al:RouteScheme ;
    skos:prefLabel "Printed (additive manufacturing)"@en,
        "적층 제조재"@ko .

al:Quenching a skos:Concept ;
    skos:definition "Rapid cooling after solution treatment."@en,
        "용체화 처리 후 빠른 냉각."@ko ;
    skos:hiddenLabel "quench",
        "water" ;
    skos:inScheme al:StepTypeScheme ;
    skos:prefLabel "Quenching"@en,
        "급냉"@ko .

al:Rolled a skos:Concept ;
    skos:definition "Rolled product, form not specified."@en,
        "형태가 명시되지 않은 압연재."@ko ;
    skos:inScheme al:RouteScheme ;
    skos:prefLabel "Rolled"@en,
        "압연재"@ko .

al:SCCSusceptibility a skos:Concept ;
    skos:definition "An SCC index or time to failure."@en,
        "응력 부식 지수나 파단 시간."@ko ;
    skos:inScheme al:PropertyKindScheme ;
    skos:prefLabel "Stress corrosion susceptibility"@en,
        "응력 부식 민감도"@ko .

al:Sheet a skos:Concept ;
    skos:definition "Rolled sheet."@en,
        "압연 판재."@ko ;
    skos:inScheme al:RouteScheme ;
    skos:prefLabel "Sheet"@en,
        "판재"@ko .

al:T1 a skos:Concept ;
    skos:definition "Cooled from an elevated-temperature shaping process and naturally aged."@en,
        "고온 성형 후 냉각하고 자연시효. 별도 용체화는 없다."@ko ;
    skos:inScheme al:TemperScheme ;
    skos:notation "T1" ;
    skos:prefLabel "T1"@en,
        "T1"@ko ;
    al:impliesStepType al:NaturalAgeing .

al:T4 a skos:Concept ;
    skos:definition "Solution heat-treated and naturally aged."@en,
        "용체화 처리 후 자연시효."@ko ;
    skos:inScheme al:TemperScheme ;
    skos:notation "T4" ;
    skos:prefLabel "T4"@en,
        "T4"@ko ;
    al:impliesStepType al:NaturalAgeing,
        al:SolutionTreatment .

al:T5 a skos:Concept ;
    skos:definition "Cooled from an elevated-temperature shaping process and artificially aged."@en,
        "고온 성형 후 냉각하고 인공시효. 별도 용체화는 없다."@ko ;
    skos:inScheme al:TemperScheme ;
    skos:notation "T5" ;
    skos:prefLabel "T5"@en,
        "T5"@ko ;
    al:impliesStepType al:ArtificialAgeing .

al:T6 a skos:Concept ;
    skos:definition "Solution heat-treated and artificially aged."@en,
        "용체화 처리 후 인공시효."@ko ;
    skos:inScheme al:TemperScheme ;
    skos:notation "T6" ;
    skos:prefLabel "T6"@en,
        "T6"@ko ;
    al:impliesStepType al:ArtificialAgeing,
        al:SolutionTreatment .

al:T7 a skos:Concept ;
    skos:definition "Solution heat-treated and overaged or stabilized."@en,
        "용체화 처리 후 과시효 또는 안정화."@ko ;
    skos:inScheme al:TemperScheme ;
    skos:notation "T7" ;
    skos:prefLabel "T7"@en,
        "T7"@ko ;
    al:impliesStepType al:ArtificialAgeing,
        al:SolutionTreatment .

al:T8 a skos:Concept ;
    skos:definition "Solution heat-treated, cold worked, and artificially aged."@en,
        "용체화 처리, 냉간가공 후 인공시효."@ko ;
    skos:inScheme al:TemperScheme ;
    skos:notation "T8" ;
    skos:prefLabel "T8"@en,
        "T8"@ko ;
    al:impliesStepType al:ArtificialAgeing,
        al:SolutionTreatment .

al:T9 a skos:Concept ;
    skos:definition "Solution heat-treated, artificially aged, and cold worked."@en,
        "용체화 처리, 인공시효 후 냉간가공."@ko ;
    skos:inScheme al:TemperScheme ;
    skos:notation "T9" ;
    skos:prefLabel "T9"@en,
        "T9"@ko ;
    al:impliesStepType al:ArtificialAgeing,
        al:SolutionTreatment .

al:W a skos:Concept ;
    skos:definition "Solution heat-treated; unstable, naturally ageing."@en,
        "용체화 처리 직후. 불안정하며 자연시효가 진행 중이다."@ko ;
    skos:inScheme al:TemperScheme ;
    skos:notation "W" ;
    skos:prefLabel "W (solution heat-treated)"@en,
        "W (용체화 직후)"@ko ;
    al:impliesStepType al:SolutionTreatment .

al:Wire a skos:Concept ;
    skos:definition "Wire product."@en,
        "선재."@ko ;
    skos:inScheme al:RouteScheme ;
    skos:prefLabel "Wire"@en,
        "와이어"@ko .

<https://w3id.org/alml> a owl:Ontology ;
    dcterms:description "What each study predicts, from which data and features, with which models and scores, and what it concludes, with quote evidence."@en,
        "각 연구가 무엇을, 어떤 데이터와 입력 특징으로, 어떤 모델로 예측했고 성능과 결론이 무엇인지를 인용 근거와 함께 표현한다."@ko ;
    dcterms:title "Machine-learning studies of aluminium alloys"@en,
        "알루미늄 합금 머신러닝 연구 온톨로지"@ko ;
    owl:versionInfo "0.2.0" .

ml:accessUrl a owl:DatatypeProperty ;
    rdfs:label "access URL"@en,
        "공개 주소"@ko ;
    rdfs:comment "Where the data is published (repository DOI or URL)."@en,
        "데이터 공개 위치(저장소 DOI나 URL)."@ko ;
    rdfs:domain ml:Dataset ;
    rdfs:range xsd:anyURI .

ml:algorithm a owl:ObjectProperty ;
    rdfs:label "algorithm"@en,
        "알고리즘"@ko ;
    rdfs:comment "The model's algorithm (ml:AlgorithmScheme)."@en,
        "모델의 알고리즘(ml:AlgorithmScheme)."@ko ;
    rdfs:domain ml:Model ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso ml:AlgorithmScheme .

ml:alloySeries a owl:ObjectProperty ;
    rdfs:label "alloy series"@en,
        "합금 계열"@ko ;
    rdfs:comment "An alloy family the task covers (al:SeriesScheme)."@en,
        "과제가 다루는 합금 계열(al:SeriesScheme)."@ko ;
    rdfs:domain ml:Task ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso al:SeriesScheme .

ml:dataSource a owl:ObjectProperty ;
    rdfs:label "data source"@en,
        "데이터 출처"@ko ;
    rdfs:comment "Where the data comes from: experiments, literature, handbooks or simulation (ml:DataSourceScheme)."@en,
        "데이터가 온 곳: 실험, 문헌, 핸드북, 시뮬레이션(ml:DataSourceScheme)."@ko ;
    rdfs:domain ml:Dataset ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso ml:DataSourceScheme .

ml:evaluatedOn a owl:ObjectProperty ;
    rdfs:label "evaluated on"@en,
        "평가 데이터"@ko ;
    rdfs:comment "Which data gave the score: held-out test, cross-validation or external validation (ml:EvaluationScheme)."@en,
        "점수를 낸 데이터: 시험 세트, 교차 검증, 외부 검증(ml:EvaluationScheme)."@ko ;
    rdfs:domain ml:Score ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso ml:EvaluationScheme .

ml:experimentallyValidated a owl:DatatypeProperty ;
    rdfs:label "experimentally validated"@en,
        "실험 검증"@ko ;
    rdfs:comment "True when the study measured new alloys or conditions to test its predictions."@en,
        "예측을 확인하려고 새 합금이나 조건을 실제로 측정한 연구이면 참."@ko ;
    rdfs:domain ml:Study ;
    rdfs:range xsd:boolean .

ml:hasEvidence a owl:ObjectProperty ;
    rdfs:label "has evidence"@en,
        "근거"@ko ;
    rdfs:comment "A quote from the paper that backs this node."@en,
        "이 노드를 뒷받침하는 논문 인용."@ko ;
    rdfs:domain rdfs:Resource ;
    rdfs:range ml:Evidence .

ml:hasFinding a owl:ObjectProperty ;
    rdfs:label "has finding"@en,
        "결론"@ko ;
    rdfs:comment "A main conclusion of the study."@en,
        "연구의 주요 결론."@ko ;
    rdfs:domain ml:Study ;
    rdfs:range ml:Finding .

ml:hasScore a owl:ObjectProperty ;
    rdfs:label "has score"@en,
        "성능 점수"@ko ;
    rdfs:comment "A reported evaluation for the task."@en,
        "과제에 대해 보고된 평가."@ko ;
    rdfs:domain ml:Task ;
    rdfs:range ml:Score .

ml:hasTask a owl:ObjectProperty ;
    rdfs:label "has task"@en,
        "과제"@ko ;
    rdfs:comment "A task the study models."@en,
        "연구가 모델링한 과제."@ko ;
    rdfs:domain ml:Study ;
    rdfs:range ml:Task .

ml:localCopy a owl:DatatypeProperty ;
    rdfs:label "local copy"@en,
        "로컬 사본"@ko ;
    rdfs:comment "Path of the downloaded copy, when there is one."@en,
        "받아 둔 사본의 경로."@ko ;
    rdfs:domain ml:Dataset ;
    rdfs:range xsd:string .

ml:metric a owl:ObjectProperty ;
    rdfs:label "metric"@en,
        "평가 지표"@ko ;
    rdfs:comment "The evaluation metric (ml:MetricScheme)."@en,
        "평가 지표(ml:MetricScheme)."@ko ;
    rdfs:domain ml:Score ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso ml:MetricScheme ;
    skos:closeMatch mls:specifiedBy .

ml:ofModel a owl:ObjectProperty ;
    rdfs:label "of model"@en,
        "평가 대상 모델"@ko ;
    rdfs:comment "The model the score evaluates."@en,
        "점수가 평가한 모델."@ko ;
    rdfs:domain ml:Score ;
    rdfs:range ml:Model .

ml:page a owl:DatatypeProperty ;
    rdfs:label "page"@en,
        "쪽"@ko ;
    rdfs:comment "Page of the quote in the paper text."@en,
        "인용이 있는 쪽."@ko ;
    rdfs:domain ml:Evidence ;
    rdfs:range xsd:integer .

ml:quote a owl:DatatypeProperty ;
    rdfs:label "quote"@en,
        "인용"@ko ;
    rdfs:comment "Verbatim text from the paper."@en,
        "논문에서 그대로 옮긴 글."@ko ;
    rdfs:domain ml:Evidence ;
    rdfs:range xsd:string .

ml:reviewStatus a owl:DatatypeProperty ;
    rdfs:label "review status"@en,
        "검수 상태"@ko ;
    rdfs:comment "Whether a person has checked the extracted record (reviewed) or not yet (unreviewed)."@en,
        "사람이 추출 기록을 확인했는지(reviewed) 아닌지(unreviewed)."@ko ;
    rdfs:domain ml:Study ;
    rdfs:range xsd:string .

ml:sameDataAs a owl:ObjectProperty ;
    rdfs:label "same data as"@en,
        "같은 데이터"@ko ;
    rdfs:comment "The same data as a dataset node of another knowledge graph (e.g. the al6xxx KG), so it is not stored twice."@en,
        "다른 KG(예: al6xxx)의 데이터셋 노드와 같은 데이터. 두 번 저장하지 않기 위한 연결."@ko ;
    rdfs:domain ml:Dataset ;
    rdfs:range rdfs:Resource .

ml:sampleCount a owl:DatatypeProperty ;
    rdfs:label "sample count"@en,
        "데이터 수"@ko ;
    rdfs:comment "Number of data points as the paper states it."@en,
        "논문이 밝힌 데이터 수."@ko ;
    rdfs:domain ml:Dataset ;
    rdfs:range xsd:integer .

ml:scoreValue a owl:DatatypeProperty ;
    rdfs:label "score value"@en,
        "점수 값"@ko ;
    rdfs:comment "The metric value as printed in the paper."@en,
        "논문에 적힌 지표 값."@ko ;
    rdfs:domain ml:Score ;
    rdfs:range xsd:decimal .

ml:statement a owl:DatatypeProperty ;
    rdfs:label "statement"@en,
        "결론 문장"@ko ;
    rdfs:comment "The finding in one sentence."@en,
        "결론을 한 문장으로."@ko ;
    rdfs:domain ml:Finding ;
    rdfs:range xsd:string .

ml:targetProperty a owl:ObjectProperty ;
    rdfs:label "target property"@en,
        "목표 물성"@ko ;
    rdfs:comment "A property the task predicts (al:PropertyKindScheme); ml:targetText holds the paper's words when none fits."@en,
        "과제가 예측하는 물성(al:PropertyKindScheme). 맞는 것이 없으면 ml:targetText에 논문 표현을 적는다."@ko ;
    rdfs:domain ml:Task ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso al:PropertyKindScheme .

ml:targetText a owl:DatatypeProperty ;
    rdfs:label "target as written"@en,
        "목표(논문 표현)"@ko ;
    rdfs:comment "The target in the paper's words, kept when no al:PropertyKindScheme concept fits."@en,
        "논문이 쓴 목표 표현. al:PropertyKindScheme에 맞는 개념이 없을 때 남긴다."@ko ;
    rdfs:domain ml:Task ;
    rdfs:range xsd:string .

ml:taskType a owl:ObjectProperty ;
    rdfs:label "task type"@en,
        "과제 종류"@ko ;
    rdfs:comment "Regression, classification, inverse design, ... (ml:TaskTypeScheme)."@en,
        "회귀, 분류, 역설계 등(ml:TaskTypeScheme)."@ko ;
    rdfs:domain ml:Task ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso ml:TaskTypeScheme .

ml:usesDataset a owl:ObjectProperty ;
    rdfs:label "uses dataset"@en,
        "사용 데이터셋"@ko ;
    rdfs:comment "Data the task was trained or tested on."@en,
        "과제의 학습·시험 데이터."@ko ;
    rdfs:domain ml:Task ;
    rdfs:range ml:Dataset .

ml:usesFeature a owl:ObjectProperty ;
    rdfs:label "uses feature kind"@en,
        "입력 특징 종류"@ko ;
    rdfs:comment "A kind of model input (ml:FeatureKindScheme)."@en,
        "모델 입력의 종류(ml:FeatureKindScheme)."@ko ;
    rdfs:domain ml:Task ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso ml:FeatureKindScheme .

ml:usesModel a owl:ObjectProperty ;
    rdfs:label "uses model"@en,
        "사용 모델"@ko ;
    rdfs:comment "A model trained for the task."@en,
        "과제를 위해 학습한 모델."@ko ;
    rdfs:domain ml:Task ;
    rdfs:range ml:Model .

e:study-10.1002_adem.202401699 a ml:Study ;
    schema:datePublished "2025" ;
    schema:identifier "https://doi.org/10.1002/adem.202401699" ;
    schema:name "Automated Image Segmentation and Processing Pipeline Applied to X-Ray Computed Tomography Studies of Pitting Corrosion in Aluminum Wires" ;
    ml:experimentallyValidated false ;
    ml:hasFinding e:study-10.1002_adem.202401699-f0,
        e:study-10.1002_adem.202401699-f1,
        e:study-10.1002_adem.202401699-f2 ;
    ml:hasTask e:study-10.1002_adem.202401699-t0 ;
    ml:reviewStatus "reviewed" .

e:study-10.1002_maco.202414598 a ml:Study ;
