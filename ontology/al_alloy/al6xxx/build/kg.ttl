@prefix al: <https://w3id.org/al6xxx#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix e: <https://w3id.org/al6xxx/entity/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tto: <https://w3id.org/pmd/tto/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/al6xxx> a owl:Ontology ;
    dcterms:description "Composition, processing, measured properties and literature provenance of aluminium alloys of every series (2xxx-7xxx, Al-Li, cast Al-Si); 6xxx is the most complete."@en,
        "모든 계열(2xxx-7xxx, Al-Li, Al-Si 주조) 알루미늄 합금의 조성, 공정, 측정 물성, 문헌 출처를 표현한다. 6xxx가 가장 자세하다."@ko ;
    dcterms:title "Aluminium alloy ontology"@en,
        "알루미늄 합금 온톨로지"@ko ;
    owl:versionInfo "0.5.0" .

al:ContactAngle a skos:Concept ;
    skos:definition "Wetting contact angle, in degrees."@en,
        "젖음 접촉각(도)."@ko ;
    skos:inScheme al:PropertyKindScheme ;
    skos:prefLabel "Contact angle"@en,
        "접촉각"@ko .

al:EnergyForces a skos:Concept ;
    skos:definition "Atomistic energies and forces, for interatomic potentials."@en,
        "원자간 퍼텐셜용 원자 에너지와 힘."@ko ;
    skos:inScheme al:PropertyKindScheme ;
    skos:prefLabel "Energies and forces"@en,
        "에너지와 힘"@ko .

al:FatigueLife a skos:Concept ;
    skos:definition "Cycles to failure under cyclic loading."@en,
        "반복 하중에서 파단까지의 사이클 수."@ko ;
    skos:inScheme al:PropertyKindScheme ;
    skos:prefLabel "Fatigue life"@en,
        "피로 수명"@ko .

al:FatigueStrength a skos:Concept ;
    skos:definition "Stress amplitude at a given number of cycles."@en,
        "주어진 반복수에서의 응력 진폭."@ko ;
    skos:inScheme al:PropertyKindScheme ;
    skos:prefLabel "Fatigue strength"@en,
        "피로 강도"@ko .

al:Hardness a skos:Concept ;
    skos:definition "Hardness with its scale (HV, HB, HRB ...)."@en,
        "경도(HV, HB, HRB 등 척도 포함)."@ko ;
    skos:inScheme al:PropertyKindScheme ;
    skos:prefLabel "Hardness"@en,
        "경도"@ko .

al:ImpactEnergy a skos:Concept ;
    skos:definition "Charpy or Izod absorbed energy, in J."@en,
        "샤르피·아이조드 흡수 에너지(J)."@ko ;
    skos:inScheme al:PropertyKindScheme ;
    skos:prefLabel "Impact energy"@en,
        "충격 에너지"@ko .

al:InhibitionEfficiency a skos:Concept ;
    skos:definition "Efficiency of a corrosion inhibitor, in %."@en,
        "부식 억제제의 효율(%)."@ko ;
    skos:inScheme al:PropertyKindScheme ;
    skos:prefLabel "Corrosion inhibition efficiency"@en,
        "부식 억제 효율"@ko .

al:Porosity a skos:Concept ;
    skos:definition "Pore volume fraction."@en,
        "기공 부피 분율."@ko ;
    skos:inScheme al:PropertyKindScheme ;
    skos:prefLabel "Porosity"@en,
        "기공률"@ko .

al:RelativeDensity a skos:Concept ;
    skos:definition "Density relative to the full density, in %."@en,
        "완전 밀도 대비 밀도(%)."@ko ;
    skos:inScheme al:PropertyKindScheme ;
    skos:prefLabel "Relative density"@en,
        "상대 밀도"@ko .

al:SDAS a skos:Concept ;
    skos:definition "SDAS of cast or printed alloys, in um."@en,
        "주조·적층 합금의 SDAS(um)."@ko ;
    skos:inScheme al:PropertyKindScheme ;
    skos:prefLabel "Secondary dendrite arm spacing"@en,
        "2차 수지상 간격"@ko .

al:Series1xxx a skos:Concept ;
    skos:definition "Alloy family by main alloying elements: pure Al (1xxx)."@en,
        "주 합금 원소로 나눈 합금 계열: 순수 Al(1xxx)."@ko ;
    skos:inScheme al:SeriesScheme ;
    skos:notation "1xxx" ;
    skos:prefLabel "Pure Al (1xxx)"@en,
        "순수 Al(1xxx)"@ko .

al:Series3xxx a skos:Concept ;
    skos:definition "Alloy family by main alloying elements: Al-Mn (3xxx)."@en,
        "주 합금 원소로 나눈 합금 계열: Al-Mn계(3xxx)."@ko ;
    skos:inScheme al:SeriesScheme ;
    skos:notation "3xxx" ;
    skos:prefLabel "Al-Mn (3xxx)"@en,
        "Al-Mn계(3xxx)"@ko .

al:Series4xxx a skos:Concept ;
    skos:definition "Alloy family by main alloying elements: wrought Al-Si (4xxx)."@en,
        "주 합금 원소로 나눈 합금 계열: Al-Si 가공재(4xxx)."@ko ;
    skos:inScheme al:SeriesScheme ;
    skos:notation "4xxx" ;
    skos:prefLabel "Al-Si wrought (4xxx)"@en,
        "Al-Si 가공재(4xxx)"@ko .

al:SeriesCastAlMg a skos:Concept ;
    skos:definition "Alloy family by main alloying elements: cast Al-Mg (5xx.x)."@en,
        "주 합금 원소로 나눈 합금 계열: Al-Mg 주조 합금(5xx.x)."@ko ;
    skos:inScheme al:SeriesScheme ;
    skos:notation "cast_AlMg" ;
    skos:prefLabel "Cast Al-Mg"@en,
        "Al-Mg 주조 합금"@ko .

al:SurfaceRoughness a skos:Concept ;
    skos:definition "Surface roughness such as Ra, in um."@en,
        "Ra 같은 표면 거칠기(um)."@ko ;
    skos:inScheme al:PropertyKindScheme ;
    skos:prefLabel "Surface roughness"@en,
        "표면 거칠기"@ko .

al:ThermalConductivity a skos:Concept ;
    skos:definition "Thermal conductivity, in W/(m K)."@en,
        "열전도도(W/(m K))."@ko ;
    skos:inScheme al:PropertyKindScheme ;
    skos:prefLabel "Thermal conductivity"@en,
        "열전도도"@ko .

al:compKey a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "composition key"@en,
        "조성 키"@ko ;
    rdfs:comment "The 29 solute contents rounded to 3 decimals and joined by '|', as comp_key in unified_strength; equal keys mean the same alloy."@en,
        "용질 29개 함량을 소수 셋째 자리로 반올림해 '|'로 이은 값(unified_strength의 comp_key). 키가 같으면 같은 합금이다."@ko ;
    rdfs:domain al:Alloy ;
    rdfs:range xsd:string .

al:designation a owl:DatatypeProperty ;
    rdfs:label "designation"@en,
        "규격명"@ko ;
    rdfs:comment "A standard alloy designation such as AA6061, when the source gives one."@en,
        "출처가 밝힌 규격 합금명(예: AA6061)."@ko ;
    rdfs:domain al:Alloy ;
    rdfs:range xsd:string .

al:durationH a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "duration (h)"@en,
        "시간(h)"@ko ;
    rdfs:comment "Hold time of the step in hours."@en,
        "단계의 유지 시간(시간 단위)."@ko ;
    rdfs:domain al:ProcessStep ;
    rdfs:range xsd:decimal .

al:element a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "element"@en,
        "원소"@ko ;
    rdfs:comment "Chemical symbol, e.g. Mg."@en,
        "원소 기호. 예: Mg."@ko ;
    rdfs:domain al:ElementContent ;
    rdfs:range xsd:string .

al:environment a owl:DatatypeProperty ;
    rdfs:label "environment"@en,
        "시험 환경"@ko ;
    rdfs:comment "Test medium as reported (solution, and temperature or duration when given), e.g. 3.5 wt% NaCl, 25 °C."@en,
        "보고된 시험 용액(주어지면 온도·시간 포함). 예: 3.5 wt% NaCl, 25 °C."@ko ;
    rdfs:domain al:CorrosionTest ;
    rdfs:range xsd:string .

al:hasConstituent a owl:ObjectProperty ;
    rdfs:label "has constituent"@en,
        "구성 원소"@ko ;
    rdfs:comment "An element content of the alloy."@en,
        "합금의 원소 함량."@ko ;
    rdfs:domain al:Alloy ;
    rdfs:range al:ElementContent .

al:hasEvidence a owl:ObjectProperty ;
    rdfs:label "has evidence"@en,
        "근거"@ko ;
    rdfs:comment "A quote backing the value."@en,
        "값을 뒷받침하는 인용."@ko ;
    rdfs:domain al:PropertyValue ;
    rdfs:range al:Evidence .

al:hasProcessStep a owl:ObjectProperty ;
    rdfs:label "has process step"@en,
        "공정 단계"@ko ;
    rdfs:comment "A reported step of the sample's processing history. An absent step means not reported, unless the temper does not imply it."@en,
        "시료 공정 이력 가운데 보고된 단계. 템퍼가 요구하는데 없는 단계는 미보고로 본다."@ko ;
    rdfs:domain al:Sample ;
    rdfs:range al:ProcessStep .

al:hasPropertyValue a owl:ObjectProperty ;
    rdfs:label "has property value"@en,
        "물성값"@ko ;
    rdfs:comment "A property value reported or predicted for the sample."@en,
        "시료에 대해 보고되거나 예측된 물성값."@ko ;
    rdfs:domain al:Sample ;
    rdfs:range al:PropertyValue .

al:hasRoute a owl:ObjectProperty ;
    rdfs:label "has route"@en,
        "가공 방식"@ko ;
    rdfs:comment "The product form or forming route (al:RouteScheme). Omitted when not reported."@en,
        "제품 형태나 가공 방식(al:RouteScheme). 보고되지 않았으면 생략한다."@ko ;
    rdfs:domain al:Sample ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso al:RouteScheme .

al:hasTemper a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has temper"@en,
        "템퍼"@ko ;
    rdfs:comment "The temper designation of the sample, a concept of al:TemperScheme."@en,
        "시료의 템퍼 기호. al:TemperScheme의 개념이다."@ko ;
    rdfs:domain al:Sample ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso al:TemperScheme .

al:heatingMethod a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "heating method"@en,
        "가열 방식"@ko ;
    rdfs:comment "How the step was heated, when the source says so (al:HeatingScheme)."@en,
        "출처가 밝힌 경우, 단계의 가열 방식(al:HeatingScheme)."@ko ;
    rdfs:domain al:ProcessStep ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso al:HeatingScheme .

al:impliesStepType a owl:ObjectProperty ;
    rdfs:label "implies step type"@en,
        "필요 단계"@ko ;
    rdfs:comment "A step type that a temper designation requires by definition; used to tell unreported steps from steps not performed."@en,
        "템퍼 정의상 반드시 거친 단계 종류. 미보고 단계와 하지 않은 단계를 구분하는 데 쓴다."@ko ;
    rdfs:domain skos:Concept ;
    rdfs:range skos:Concept .

al:inSeries a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "in series"@en,
        "합금 계열"@ko ;
    rdfs:comment "The alloy family (al:SeriesScheme) as the source classifies it; left out when the source says other."@en,
        "출처가 분류한 합금 계열(al:SeriesScheme). 출처가 기타로 분류하면 두지 않는다."@ko ;
    rdfs:domain al:Alloy ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso al:SeriesScheme .

al:massPercent a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "mass percent"@en,
        "질량 백분율"@ko ;
    rdfs:comment "Content in wt%."@en,
        "함량(wt%)."@ko ;
    rdfs:domain al:ElementContent ;
    rdfs:range xsd:decimal .

al:notReported a owl:DatatypeProperty ;
    rdfs:label "not reported"@en,
        "미보고 항목"@ko ;
    rdfs:comment "An item the source does not report in text or tables, e.g. 'EL only shown in Fig. 5'."@en,
        "출처가 본문이나 표에 보고하지 않은 항목. 예: 'EL은 그림 5에만 있음'."@ko ;
    rdfs:domain schema:CreativeWork ;
    rdfs:range xsd:string .

al:ofAlloy a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "of alloy"@en,
        "합금"@ko ;
    rdfs:comment "The alloy the sample is made of."@en,
        "시료를 이루는 합금."@ko ;
    rdfs:domain al:Sample ;
    rdfs:range al:Alloy .

al:page a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "page"@en,
        "페이지"@ko ;
    rdfs:comment "Page of the source where the quote occurs."@en,
        "인용이 있는 출처의 페이지."@ko ;
    rdfs:domain al:Evidence ;
    rdfs:range xsd:integer .

al:propertyKind a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "property kind"@en,
        "물성 종류"@ko ;
    rdfs:comment "Which property the value is of, a concept of al:PropertyKindScheme."@en,
        "값이 어떤 물성인지. al:PropertyKindScheme의 개념이다."@ko ;
    rdfs:domain al:PropertyValue ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso al:PropertyKindScheme .

al:qualityFlag a owl:DatatypeProperty ;
    rdfs:label "quality flag"@en,
        "품질 표시"@ko ;
    rdfs:comment "Why a sample's reported values are doubtful, e.g. 'YTS exceeds UTS'. Set by the build from shapes/rules.rq, shared-composition designations and curation/flags.csv; the source values are kept unchanged."@en,
        "시료의 보고값이 의심스러운 이유. 예: 'YTS exceeds UTS'. 빌드가 shapes/rules.rq, 조성이 겹치는 규격명, curation/flags.csv에서 붙이며 원본 값은 바꾸지 않는다."@ko ;
    rdfs:domain al:Sample ;
    rdfs:range xsd:string .

al:quote a owl:DatatypeProperty ;
    rdfs:label "quote"@en,
        "인용문"@ko ;
    rdfs:comment "Verbatim text copied from the source."@en,
        "출처에서 그대로 옮긴 원문."@ko ;
    rdfs:domain al:Evidence ;
    rdfs:range xsd:string .

al:ratingValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "rating"@en,
        "등급"@ko ;
    rdfs:comment "A categorical result such as Excellent or Good (corrosion ratings)."@en,
        "Excellent, Good 같은 범주형 결과(부식 등급)."@ko ;
    rdfs:domain al:PropertyValue ;
    rdfs:range xsd:string .

al:referenceElectrode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "reference electrode"@en,
        "기준전극"@ko ;
    rdfs:comment "Reference electrode of the test's potentials as the paper names it, e.g. SCE or Ag/AgCl; potentials compare only on one reference."@en,
        "시험 전위의 기준전극(논문 표기). 예: SCE, Ag/AgCl. 전위는 같은 기준전극끼리만 비교한다."@ko ;
    rdfs:domain al:CorrosionTest ;
    rdfs:range xsd:string .

al:reviewStatus a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "review status"@en,
        "검수 상태"@ko ;
    rdfs:comment "'reviewed' after a person checked the quote against the source, else 'unreviewed'."@en,
        "사람이 출처와 대조했으면 'reviewed', 아니면 'unreviewed'."@ko ;
    rdfs:domain al:Evidence ;
    rdfs:range xsd:string .

al:reviewedBy a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "reviewed by"@en,
        "검수자"@ko ;
    rdfs:comment "Who set 'reviewed', as the record states it, e.g. an AI review the user delegated. Absent when the record names no reviewer (a person by default)."@en,
        "'reviewed'로 바꾼 주체를 기록에 적힌 그대로 적는다. 예: 사용자가 위임한 AI 검수. 기록에 검수자가 없으면 생략한다(기본은 사람)."@ko ;
    rdfs:domain al:Evidence ;
    rdfs:range xsd:string .

al:stepIndex a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "step index"@en,
        "단계 순번"@ko ;
    rdfs:comment "Position of the step in the processing history, starting at 1."@en,
        "공정 이력에서 단계의 순서(1부터)."@ko ;
    rdfs:domain al:ProcessStep ;
    rdfs:range xsd:integer .

al:stepType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "step type"@en,
        "단계 종류"@ko ;
    rdfs:comment "The kind of the step, a concept of al:StepTypeScheme."@en,
        "단계의 종류. al:StepTypeScheme의 개념이다."@ko ;
    rdfs:domain al:ProcessStep ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso al:StepTypeScheme .

al:temperatureC a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "temperature (°C)"@en,
        "온도(°C)"@ko ;
    rdfs:comment "Hold temperature of the step in degrees Celsius."@en,
        "단계의 유지 온도(섭씨)."@ko ;
    rdfs:domain al:ProcessStep ;
    rdfs:range xsd:decimal .

al:testClass a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "test class"@en,
        "시험 범주"@ko ;
    rdfs:comment "Controlled class of the reported corrosion method; Other means no vocabulary match."@en,
        "보고된 부식 방법의 통제 범주. Other는 어휘 검색어와 일치하지 않음을 뜻한다."@ko ;
    rdfs:domain al:CorrosionTest ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso al:CorrosionTestScheme .

al:testMethod a owl:DatatypeProperty ;
    rdfs:label "test method"@en,
        "시험 방법"@ko ;
    rdfs:comment "Test method or standard as reported, e.g. ISO 11846."@en,
        "보고된 시험 방법이나 규격. 예: ISO 11846."@ko ;
    rdfs:domain al:CorrosionTest ;
    rdfs:range xsd:string .

al:underTest a owl:ObjectProperty ;
    rdfs:label "under test"@en,
        "시험 조건"@ko ;
    rdfs:comment "The corrosion test that produced the value."@en,
        "값을 만든 부식 시험."@ko ;
    rdfs:domain al:PropertyValue ;
    rdfs:range al:CorrosionTest .

e:article-doi-10.1007_s40735-020-00359-6 a schema:ScholarlyArticle ;
    schema:contentUrl "runs/literature/papers/alloy/2026-09-27_6xxx-corrosion-skku/10.1007_s40735-020-00359-6.txt" ;
    schema:identifier "https://doi.org/10.1007/s40735-020-00359-6" ;
    schema:name "Corrosion Performance and Wear Behaviour of AA6061 Reinforced Hybrid: Nano-Rice Husk Ash/Clay Particulate for Cooling Tower Fan Blade in 0.75 M H2SO4" ;
    al:notReported "AA6061 + 8% clay + RHA at 75 µm (jcorr 5.17e-5 A/cm2, CR 0.60159 mm/y, Rp 508.07 ohm cm2) and at 150 µm (jcorr 1.22e-4 A/cm2, CR 1.3623 mm/y, Rp 251.27 ohm cm2) are separate reinforcement loadings in Table 2, but the checker groups them with the 2% counterparts because the paper does not tabulate the composite's measured composition; left for the reviewer",
        "OCP (Eocp) values are only in Fig. 9 (figure), not tabulated",
        "Pitting potential, Rct (EIS), corrosion depth, and SCC index not reported",
        "Pouring temperature 680 °C exceeds the allowed step-temperature range (20-650 °C), so it is not recorded as a step temperature",
        "Reference electrode for the 0.75 M H2SO4 polarization tests not stated in the paper, so Ecorr values (−0.72218, −0.65118, −0.62825, −0.70882, −0.71588 V) are left out of properties",
        "Stir casting details (450 rpm, 10 min stirring, 3 kg charge, 92%/98% matrix fractions) are process parameters not captured as steps",
        "Table 1 lists O 5.0 wt% for the AA6061 matrix, which is unusual for a wrought alloy and not an allowed element, so it is left out of composition_wt",
        "Temper not stated for any sample (as-received / as-cast only)",
        "UTS, YTS, EL not reported for any sample (only corrosion and wear results are tabulated)",
        "Wear rate and coefficient of friction values are only in Figs. 10-11 (figures), not tabulated" .

e:article-doi-10.1038_s41529-025-00683-7 a schema:ScholarlyArticle ;
    schema:contentUrl "runs/literature/papers/alloy/2026-09-27_6xxx-corrosion-skku/10.1038_s41529-025-00683-7.txt" ;
    schema:identifier "https://doi.org/10.1038/s41529-025-00683-7" ;
    schema:name "Influence of micro-structure on the corrosion behaviour of glass-bead blasted AA6061-B4C MMC in H3BO3 solution" ;
    al:notReported "Accelerated test (air bubbles fixed to the surface) was evaluated only qualitatively (preferential oxidation zones, corrosion products layer 20–25 µm thick); no quantitative corrosion values reported",
        "Corrosion depth: only a qualitative maximum of 'upto 130 µm' in Fig. 12 (figure, not a tabulated value)",
