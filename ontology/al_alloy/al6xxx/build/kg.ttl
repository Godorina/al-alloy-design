        "모델(ML 대리모델 또는 ICL)이 만든 값. prov:wasGeneratedBy로 실행을, prov:used로 입력을 가리킨다."@ko ;
    rdfs:subClassOf al:PropertyValue .

al:Printed a skos:Concept ;
    skos:definition "Additively manufactured part, e.g. laser powder bed fusion or wire-arc."@en,
        "레이저 분말 베드 용융, 와이어 아크 등으로 적층 제조한 부품."@ko ;
    skos:inScheme al:RouteScheme ;
    skos:prefLabel "Printed (additive manufacturing)"@en,
        "적층 제조재"@ko .

al:Rating a skos:Concept ;
    skos:definition "Categorical corrosion-rating tests."@en,
        "범주형 내식 등급 시험."@ko ;
    skos:hiddenLabel "jsm",
        "rating" ;
    skos:inScheme al:CorrosionTestScheme ;
    skos:prefLabel "Rating"@en,
        "등급"@ko .

al:SaltSpray a skos:Concept ;
    skos:definition "Salt-spray, fog, or cyclic wet/dry exposure."@en,
        "염수분무·포그·습건 반복 노출."@ko ;
    skos:hiddenLabel "cyclic wet",
        "salt fog",
        "salt spray",
        "wet/dry" ;
    skos:inScheme al:CorrosionTestScheme ;
    skos:prefLabel "Salt spray"@en,
        "염수분무"@ko .

al:T9 a skos:Concept ;
    skos:definition "Solution heat-treated, artificially aged, and cold worked."@en,
        "용체화 처리, 인공시효 후 냉간가공."@ko ;
    skos:inScheme al:TemperScheme ;
    skos:notation "T9" ;
    skos:prefLabel "T9"@en,
        "T9"@ko ;
    al:impliesStepType al:ArtificialAgeing,
        al:SolutionTreatment .

