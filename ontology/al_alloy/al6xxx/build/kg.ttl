al:HeatingScheme a skos:ConceptScheme ;
    rdfs:label "Heating methods"@en,
        "가열 방식"@ko .

al:Infrared a skos:Concept ;
    skos:altLabel "IR"@en ;
    skos:definition "Rapid infrared heating."@en,
        "급속 적외선 가열."@ko ;
    skos:inScheme al:HeatingScheme ;
    skos:prefLabel "Infrared"@en,
        "적외선"@ko .

al:NitricAcidMassLoss a skos:Concept ;
    skos:definition "NAMLT/G67 nitric-acid mass-loss tests."@en,
        "NAMLT/G67 질산 질량감소 시험."@ko ;
    skos:hiddenLabel "g67",
        "namlt" ;
    skos:inScheme al:CorrosionTestScheme ;
    skos:prefLabel "Nitric-acid mass loss"@en,
        "질산 질량감소"@ko .

al:O a skos:Concept ;
    skos:definition "Annealed to the softest condition."@en,
        "가장 무른 상태로 소둔."@ko ;
    skos:inScheme al:TemperScheme ;
    skos:notation "O" ;
    skos:prefLabel "O (annealed)"@en,
        "O (소둔)"@ko ;
    al:impliesStepType al:Annealing .

al:OpenCircuit a skos:Concept ;
    skos:definition "Open-circuit-potential measurements."@en,
        "개방회로 전위 측정."@ko ;
    skos:hiddenLabel "ocp",
        "open circuit" ;
    skos:inScheme al:CorrosionTestScheme ;
    skos:prefLabel "Open circuit"@en,
        "개방회로"@ko .

