    skos:closeMatch tto:PercentageElongationAfterFracture ;
    skos:definition "Elongation after fracture in a tensile test, in %."@en,
        "인장시험의 파단 연신율(%)."@ko ;
    skos:inScheme al:PropertyKindScheme ;
    skos:prefLabel "Elongation"@en,
        "연신율"@ko .

al:UTS a skos:Concept ;
    skos:closeMatch tto:TensileStrength ;
    skos:definition "Maximum engineering stress in a tensile test, in MPa."@en,
        "인장시험의 최대 공칭응력(MPa)."@ko ;
    skos:inScheme al:PropertyKindScheme ;
    skos:prefLabel "Ultimate tensile strength"@en,
        "인장강도"@ko .

al:Sample a owl:Class ;
    rdfs:label "Sample"@en,
        "시료"@ko ;
    rdfs:comment "Material of one alloy in one temper after one processing history; the thing whose properties are reported."@en,
        "한 합금이 하나의 공정 이력을 거쳐 한 템퍼 상태가 된 재료. 물성은 시료에 붙는다."@ko ;
    rdfs:subClassOf prov:Entity .

e:ds-mendeley a schema:Dataset ;
    schema:identifier "https://doi.org/10.1016/j.commatsci.2023.112270" ;
    schema:name "Bhat, Barnard, Birbilis 2023, Computational Materials Science (data 10.17632/b6br4yk6r3.1)" .

al:ProcessStep a owl:Class ;
    rdfs:label "Process step"@en,
        "공정 단계"@ko ;
    rdfs:comment "One step of a sample's processing history, typed by al:stepType and ordered by al:stepIndex."@en,
        "시료 공정 이력의 한 단계. 종류는 al:stepType, 순서는 al:stepIndex로 나타낸다."@ko ;
    rdfs:subClassOf prov:Activity .

al:MeasuredValue a owl:Class ;
    rdfs:label "Measured value"@en,
        "실측값"@ko ;
    rdfs:comment "A value obtained by testing the sample."@en,
        "시료를 실제로 시험해서 얻은 값."@ko ;
    rdfs:subClassOf al:PropertyValue .

al:ElementContent a owl:Class ;
    rdfs:label "Element content"@en,
        "원소 함량"@ko ;
    rdfs:comment "The mass percent of one element in an alloy. Aluminium is the balance and is not recorded."@en,
        "합금에 들어 있는 원소 하나의 질량 백분율. 알루미늄은 잔부라 기록하지 않는다."@ko .

[] a owl:AllDisjointClasses ;
    owl:members ( al:MeasuredValue al:NominalValue al:PredictedValue ) .

